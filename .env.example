# ─────────────────────────────────────────────────────────────
# Office AI · variables de entorno
# Copiá este archivo a .env.local y ajustá según tu setup.
# .env* está en .gitignore, así que no se commitea.
# ─────────────────────────────────────────────────────────────

# Provider de IA: auto | ollama | openai | groq | gemini | stub
#   auto  → intenta Ollama primero y cae a cloud si hay API keys
#   stub  → respuestas locales enlatadas (sin modelo). Útil para demo offline.
AI_PROVIDER=ollama

# ── Ollama (IA local) ───────────────────────────────────────
# Asegurate de tener `ollama serve` corriendo y los modelos pulleados:
#   ollama pull qwen2.5:7b
#   ollama pull llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434

# Modelo por defecto para especialistas (pesado) y router/ARIA (liviano).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_ROUTER=llama3.2:3b
# Opcional: modelo por agente, ej. OLLAMA_MODEL_APEX=qwen2.5-coder:7b
# OLLAMA_MODEL_SPECIALIST=qwen2.5:7b
# OLLAMA_MODEL_FAST=llama3.2:3b

OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=4096

# ── Tunables del orquestador ────────────────────────────────
# Subílos si tu modelo local corre en CPU: los defaults asumen ~30s.
ORCHESTRATOR_TIMEOUT_MS=30000
ORCHESTRATOR_RAPID_TIMEOUT_MS=20000
ORCHESTRATOR_APEX_TIMEOUT_MS=45000
ORCHESTRATOR_PLANNER_TIMEOUT_MS=25000
ORCHESTRATOR_SUBAGENT_TIMEOUT_MS=20000

ORCHESTRATOR_LEAD_TOKENS=600
ORCHESTRATOR_RAPID_TOKENS=300
ORCHESTRATOR_APEX_TOKENS=800
ORCHESTRATOR_PLANNER_TOKENS=300
ORCHESTRATOR_SUBAGENT_TOKENS=320

# Cuántos runs de observabilidad se guardan en disco y cuántos turnos de
# historial se reinyectan al prompt por sesión.
ORCHESTRATOR_MAX_RUNS=200
ORCHESTRATOR_HISTORY_TURNS=6

# Modo de síntesis de SCOUT: extractive | hybrid | model
#   hybrid (default) = sintetiza con modelo sobre contenido real y cae a
#   extractivo si ningún provider responde.
SCOUT_SYNTHESIS_MODE=hybrid

# Lectura profunda de páginas de SCOUT: cuántas de las URLs top abre y lee
# en profundidad para pasarle contenido real (no solo el snippet) al modelo.
# Poné SCOUT_PAGE_FETCH_COUNT=0 para desactivar la lectura.
SCOUT_PAGE_FETCH_COUNT=2
SCOUT_PAGE_EXCERPT_CHARS=1800
SCOUT_PAGE_TIMEOUT_MS=6000

# ── Providers cloud (opcionales, fallback de AI_PROVIDER=auto) ──
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# ── n8n (demo de intake) ────────────────────────────────────
# N8N_OFFICE_WEBHOOK_URL=http://127.0.0.1:5678/webhook/office-ai/intake
